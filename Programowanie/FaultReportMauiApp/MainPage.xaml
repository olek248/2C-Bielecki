<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FaultReportMauiApp.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FaultReportMauiApp"
             x:Name="thisPage"
             Title="Zgłoszenie Usterki">


    <ContentPage.Resources>
        <ResourceDictionary>
            <local:NonEmptyTextConverter x:Key="NonEmptyTextConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="15"
                             BindingContext="{x:Reference thisPage}">

  
            <Label Text="Opisz zauważoną usterkę"
                   FontSize="18"
                   FontAttributes="Bold" />


            <Editor x:Name="FaultEditor"
                    Placeholder="Wpisz opis usterki tutaj..."
                    Text="{Binding FaultDescription}"
                    HeightRequest="120" />


            <Button Text="Wyślij zgłoszenie"
                    Command="{Binding SendCommand}"
                    IsEnabled="{Binding Text, Source={x:Reference FaultEditor}, Converter={StaticResource NonEmptyTextConverter}}" />


            <Label Text="{Binding StatusMessage}"
                   FontSize="16"
                   TextColor="Green"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>