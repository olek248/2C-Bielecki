<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="WypozyczalniaSportowaMauiApp.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="thisPage"
             Title="Wypożyczalnia Sprzętu">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="12"
                             BindingContext="{x:Reference thisPage}">

            <Label Text="Wypożyczalnia Sprzętu"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

           
            <Label Text="Imię i nazwisko klienta:" />
            <Entry Placeholder="np. Jan Kowalski"
                   Text="{Binding CustomerName}" />

         
            <Label Text="Wybierz sprzęt:" />
            <CollectionView ItemsSource="{Binding EquipmentList}"
                            SelectedItem="{Binding SelectedEquipment}"
                            SelectionMode="Single"
                            HeightRequest="160">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding DisplayText}"
                               FontSize="16"
                               Padding="10" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

         
            <Label Text="{Binding DaysCount, StringFormat='Liczba dni wypożyczenia: {0}'}"
                   FontAttributes="Bold" />
            <Stepper Minimum="1"
                     Maximum="7"
                     Value="{Binding DaysCount}" />

       
            <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                <CheckBox IsChecked="{Binding HasInsurance}" />
                <Label Text="Ubezpieczenie (+5 zł / dzień)"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

           
            <Button Text="Oblicz koszt"
                    Command="{Binding CalculateCommand}"
                    Margin="0,10,0,0" />

           
            <Label Text="{Binding SummaryText}"
                   FontSize="15"
                   Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
